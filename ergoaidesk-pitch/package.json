{
  "name": "ergoaidesk-pitch",
  "version": "1.0.0",
  "description": "ERGO-AI DESK pitch video (International 3-Minute OSH Innovation Challenge 2026)",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.542",
    "@remotion/google-fonts": "4.0.542",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.542",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "d3-geo": "^3.1.2",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "world-atlas": "^2.0.2"
  },
  "scripts": {
    "dev": "npm run scan && remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc --noEmit",
    "scan": "tsx scripts/scan-assets.ts",
    "check": "npm run scan && tsx scripts/check-spec.ts && tsc --noEmit",
    "check:audio": "tsx scripts/check-audio.ts",
    "stills": "npm run scan && tsx scripts/render-stills.ts",
    "render": "npm run scan && remotion render ErgoAIDeskPitch out/ergoaidesk-pitch.mp4 --codec=h264 --crf=18"
  },
  "allowScripts": {
    "esbuild": false
  }
}